{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "npm": {
    "rangeStrategy": "bump"
  },
  "packageRules": [
    {
      "matchPackageNames": ["node"],
      "matchDepTypes": ["engines"],
      "enabled": false
    },
    {
      "matchDatasources": ["npm"],
      "matchDepTypes": "peerDependencies",
      "enabled": false
    },
    {
      "matchDatasources": ["npm"],
      "groupName": "babel mono repo",
      "matchPackageNames": ["/^@babel//"]
    },
    {
      "matchDatasources": ["npm"],
      "groupName": "react-query mono repo",
      "matchSourceUrls": ["https://github.com/TanStack/query"]
    },
    {
      "matchDatasources": ["npm"],
      "groupName": "typescript-eslint mono repo",
      "matchPackageNames": ["/^@typescript-eslint//"]
    },
    {
      "matchDatasources": ["npm"],
      "groupName": "shelter-ui mono repo",
      "matchSourceUrls": ["https://github.com/pplancq/shelter-ui"]
    },
    {
      "matchDatasources": ["npm"],
      "groupName": "React ecosystem",
      "groupSlug": "react-ecosystem",
      "matchPackageNames": ["react", "react-dom", "/^@types/react(-dom)?$/"]
    },
    {
      "matchDatasources": ["npm"],
      "groupName": "Nx tooling",
      "groupSlug": "nx-tooling",
      "matchPackageNames": ["/^@nx//", "nx", "@pplancq/nx-release-plugin"]
    },
    {
      "matchDatasources": ["npm"],
      "groupName": "dev-tools config",
      "groupSlug": "dev-tools-config",
      "matchPackageNames": ["/^@pplancq/.+-config$/"]
    },
    {
      "matchManagers": ["mise"],
      "groupName": "Node.js and npm",
      "groupSlug": "node-npm",
      "matchPackageNames": ["node", "npm"]
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["packageManager"],
      "groupName": "Node.js and npm",
      "groupSlug": "node-npm",
      "matchPackageNames": ["npm"]
    }
  ]
}
